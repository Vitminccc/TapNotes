.budget-card {
  background: linear-gradient(135deg, #0F3460 0%, #1A4D8F 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(15, 52, 96, 0.3);
}

.card-header {
  margin-bottom: 16rpx;
}

.budget-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.total-amount {
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  letter-spacing: 2rpx;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #E9B824 0%, #F5D061 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item.right {
  align-items: flex-end;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
}
