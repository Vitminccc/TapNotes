.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
  opacity: 0.6;
  transition: all 0.2s;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
  transition: all 0.2s;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1.1);
}

.tab-item.active .tab-text {
  color: #0F3460;
  font-weight: 600;
}
