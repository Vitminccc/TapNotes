.category-picker {
  width: 100%;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  padding: 16rpx 24rpx;
}

.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
  width: 120rpx;
  flex-shrink: 0;
}

.cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
  transition: transform 0.2s;
}

.cat-name {
  font-size: 24rpx;
  color: #666;
}

.cat-item.active .cat-icon {
  transform: scale(1.1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.cat-item.active .cat-name {
  color: #0F3460;
  font-weight: 500;
}
