.ai-advisor {
  width: 100%;
}

/* ===== 加载状态 ===== */
.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.ai-loading-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.ai-pulse {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(15, 52, 96, 0.1);
  animation: ai-pulse-anim 1.5s ease-in-out infinite;
}

@keyframes ai-pulse-anim {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.3); opacity: 0; }
}

.ai-emoji {
  font-size: 48rpx;
  z-index: 1;
}

.ai-loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== 空状态 ===== */
.ai-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.ai-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.ai-empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.ai-empty-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #0F3460, #1a5490);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* ===== 摘要模式 ===== */
.ai-summary {
  background: linear-gradient(135deg, #E8EDF5 0%, #F0E6F5 100%);
  border-radius: 20rpx;
  padding: 28rpx;
}

.ai-summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ai-summary-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F3460;
}

.ai-arrow {
  font-size: 24rpx;
  color: #0F3460;
  opacity: 0.7;
}

.ai-summary-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ai-summary-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ai-item-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.ai-item-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

/* ===== 完整模式 ===== */
.ai-full {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.ai-full-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #0F3460 0%, #1a5490 100%);
}

.ai-full-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-icon-lg {
  font-size: 48rpx;
}

.ai-title-block {
  display: flex;
  flex-direction: column;
}

.ai-title-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.ai-title-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.ai-refresh-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
}

.ai-refresh-icon {
  font-size: 28rpx;
  color: #fff;
}

.ai-refresh-text {
  font-size: 24rpx;
  color: #fff;
}

/* ===== Tab切换 ===== */
.ai-tabs {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.ai-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.ai-tab-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.ai-tab-label {
  font-size: 24rpx;
  color: #999;
}

.ai-tab.active .ai-tab-label {
  color: #0F3460;
  font-weight: 600;
}

.ai-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #0F3460;
  border-radius: 2rpx;
}

/* ===== 内容区域 ===== */
.ai-content {
  padding: 28rpx;
}

.ai-content-summary {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  border-left: 6rpx solid #0F3460;
}

.ai-suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ai-suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ai-suggestion-dot {
  font-size: 32rpx;
  color: #0F3460;
  line-height: 1.5;
  flex-shrink: 0;
}

.ai-suggestion-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  flex: 1;
}

/* ===== 免责声明 ===== */
.ai-disclaimer {
  padding: 20rpx 28rpx;
  background: #FAFAFA;
  text-align: center;
}

.ai-disclaimer text {
  font-size: 22rpx;
  color: #bbb;
}
