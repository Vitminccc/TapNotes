<view class="page">
  <view class="container">
    <view class="card">
      <view class="form-item">
        <text class="form-label">标题</text>
        <input 
          class="form-input" 
          placeholder="请输入标题" 
          value="{{title}}"
          bindinput="onTitleInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">类型</text>
        <picker 
          mode="selector" 
          range="{{typeList}}" 
          value="{{typeIndex}}" 
          bindchange="onTypeChange"
        >
          <view class="form-picker">
            {{typeList[typeIndex]}}
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">日期</text>
        <picker 
          mode="date" 
          value="{{date}}" 
          bindchange="onDateChange"
        >
          <view class="form-picker">
            {{date}}
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">时间</text>
        <picker 
          mode="time" 
          value="{{time}}" 
          bindchange="onTimeChange"
        >
          <view class="form-picker">
            {{time}}
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view wx:if="{{type === 'bill'}}" class="form-item">
        <text class="form-label">金额</text>
        <input 
          class="form-input amount" 
          type="digit"
          placeholder="0.00" 
          value="{{amount}}"
          bindinput="onAmountInput"
        />
        <text class="unit">元</text>
      </view>
      <view class="form-item">
        <text class="form-label">重复</text>
        <picker 
          mode="selector" 
          range="{{repeatList}}" 
          value="{{repeatIndex}}" 
          bindchange="onRepeatChange"
        >
          <view class="form-picker">
            {{repeatList[repeatIndex]}}
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="section-title">备注</view>
    <view class="card remark-card">
      <textarea 
        class="remark-input" 
        placeholder="添加备注..." 
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
    </view>

    <view class="btn-group">
      <button class="btn btn-primary btn-block" bindtap="save">保存</button>
      <button wx:if="{{isEdit}}" class="btn btn-danger btn-block mt-16" bindtap="deleteSchedule">删除日程</button>
    </view>
  </view>
</view>
