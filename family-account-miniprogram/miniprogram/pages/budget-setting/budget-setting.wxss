.page {
  min-height: 100vh;
  background: #F8F4EE;
}

.container {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.form-input.amount {
  font-size: 36rpx;
  font-weight: 600;
}

.unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 8rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.add-btn {
  font-size: 28rpx;
  color: #0F3460;
  font-weight: 500;
}

.budget-edit-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.budget-edit-item:last-of-type {
  border-bottom: none;
}

.bei-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.bei-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.bei-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.bei-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.bei-input {
  width: 160rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
  font-weight: 500;
}

.bei-unit {
  font-size: 24rpx;
  color: #999;
  margin: 0 12rpx;
}

.bei-del {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx dashed #E0E0E0;
  margin-top: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F3460;
}

.save-btn-wrapper {
  margin-top: 48rpx;
  padding: 0 8rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #0F3460 0%, #1A4D8F 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  line-height: 96rpx;
}

.save-btn::after {
  border: none;
}
