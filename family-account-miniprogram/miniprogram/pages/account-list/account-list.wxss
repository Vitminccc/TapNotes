.page {
  min-height: 100vh;
  background: #F8F4EE;
}

.header {
  background: linear-gradient(180deg, #0F3460 0%, #1A4D8F 100%);
  padding: 48rpx 32rpx 80rpx;
  color: #fff;
  text-align: center;
}

.total-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.total-amount {
  font-size: 64rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.account-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.container {
  margin-top: -40rpx;
  padding: 0 32rpx 32rpx;
}

.account-list {
  padding: 0 8rpx;
}

.account-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.acc-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.acc-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.acc-info {
  flex: 1;
  min-width: 0;
}

.acc-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.acc-type-text {
  font-size: 24rpx;
  color: #999;
}

.acc-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.acc-balance {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 8rpx;
}

.acc-balance.negative {
  color: #E74C3C;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #0F3460 0%, #1A4D8F 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 52, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
