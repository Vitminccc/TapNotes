.page {
  min-height: 100vh;
  background: #F8F4EE;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(180deg, #0F3460 0%, #1A4D8F 100%);
  padding: 32rpx 32rpx 80rpx;
  color: #fff;
}

.month-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-text {
  font-size: 36rpx;
  font-weight: 600;
}

.arrow {
  font-size: 32rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}

.balance-card {
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin: 0 32rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
}

.stat-value.income {
  color: #6BCB77;
}

.stat-value.expense {
  color: #FF9A8B;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

.container {
  margin-top: -48rpx;
  padding: 0 32rpx 32rpx;
}

.quick-actions {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 26rpx;
  color: #1A1A1A;
}

.today-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.today-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.today-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.today-summary {
  font-size: 24rpx;
  color: #999;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 0 20rpx;
  padding: 0 8rpx;
}

.section-title text:first-child {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-title .more {
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-tip {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: #ccc;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #0F3460 0%, #1A4D8F 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 52, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.add-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.add-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-tabs {
  display: flex;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.panel-tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  padding: 12rpx 0;
}

.panel-tab.active {
  color: #0F3460;
  font-weight: 600;
  position: relative;
}

.panel-tab.active::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #0F3460;
  border-radius: 3rpx;
}

.panel-content {
  padding: 40rpx 32rpx;
}

.big-amount {
  text-align: center;
  font-size: 56rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.category-hint {
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
