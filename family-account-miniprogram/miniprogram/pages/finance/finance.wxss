.page {
  min-height: 100vh;
  background: #F8F4EE;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(180deg, #0F3460 0%, #1A4D8F 100%);
  padding: 32rpx;
  color: #fff;
  padding-bottom: 60rpx;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
}

.asset-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 32rpx;
}

.asset-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.eye-icon {
  font-size: 28rpx;
}

.asset-total {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

.asset-detail-row {
  display: flex;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  padding-top: 24rpx;
}

.asset-item {
  flex: 1;
  text-align: center;
}

.asset-item-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.asset-item-value {
  font-size: 26rpx;
  font-weight: 600;
}

.asset-item-value.profit.positive {
  color: #6BCB77;
}

.asset-item-value.profit.negative {
  color: #FF9A8B;
}

.container {
  margin-top: -28rpx;
  padding: 0 32rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.account-list {
  padding: 0 8rpx;
}

.account-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.acc-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.acc-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.acc-info {
  flex: 1;
  min-width: 0;
}

.acc-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.acc-type {
  font-size: 22rpx;
  color: #999;
}

.acc-right {
  flex-shrink: 0;
}

.acc-balance {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.acc-balance.negative {
  color: #E74C3C;
}

.asset-list {
  padding: 0 8rpx;
}

.asset-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.ast-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ast-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.ast-info {
  flex: 1;
  min-width: 0;
}

.ast-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ast-type {
  font-size: 22rpx;
  color: #999;
}

.ast-right {
  text-align: right;
  flex-shrink: 0;
}

.ast-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.ast-profit {
  font-size: 22rpx;
}

.ast-profit.positive {
  color: #E74C3C;
}

.ast-profit.negative {
  color: #27AE60;
}

.empty-mini {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.tools-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
  margin: 0 -8rpx;
}

.tool-item {
  width: calc(25% - 16rpx);
  margin: 0 8rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
}

.tool-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #666;
}

.members-row {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  margin: 0 8rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  margin-bottom: 16rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.member-avatar.add-avatar {
  background: #F0F0F0;
  color: #999;
  font-size: 36rpx;
}

.member-name {
  font-size: 22rpx;
  color: #666;
}
