.page {
  min-height: 100vh;
  background: #F8F4EE;
}

.container {
  padding: 32rpx;
}

.family-card {
  background: linear-gradient(135deg, #0F3460 0%, #1A4D8F 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 52, 96, 0.3);
}

.family-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.family-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.edit-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.family-name {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.family-type {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 8rpx 16rpx;
}

.section-title text:first-child {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-title .count {
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.member-role {
  font-size: 24rpx;
  color: #999;
}

.member-action {
  flex-shrink: 0;
}

.remove-btn {
  font-size: 26rpx;
  color: #E74C3C;
  padding: 12rpx 24rpx;
  background: #FDECEA;
  border-radius: 24rpx;
}

.invite-card {
  background: #fff;
  padding: 32rpx;
  text-align: center;
}

.invite-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #0F3460;
  letter-spacing: 8rpx;
  margin-bottom: 24rpx;
}

.copy-btn {
  background: #0F3460;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-bottom: 24rpx;
}

.copy-btn::after {
  border: none;
}

.invite-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}
